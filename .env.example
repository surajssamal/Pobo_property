# Supabase Configuration
# Replace these with your actual Supabase Project URL and Anon Public Key
# Found in: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Admin Secret Invite Code (Server-side only, do NOT use NEXT_PUBLIC_ prefix)
# Used to authorize new admin sign-ups securely
ADMIN_INVITE_CODE=your-secret-admin-invite-code
